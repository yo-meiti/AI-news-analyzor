{
	"$schema": "../node_modules/wrangler/config-schema.json",
	"name": "telegram-news-bot",
	"main": "index.js",
	"compatibility_date": "2025-10-08",
	"compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
	"vars": {
		"ANALYZER_API_BASE": "https://llm-chat-app-template-meiti-v1.prompt-generator.workers.dev",
		// NOTE: Do NOT commit real secret values here. Set the real token with `wrangler secret put`.
		"NOTIFY_SHARED_TOKEN": "<SET_VIA_SECRET>"
	},
	"observability": {
		"enabled": true
	}
}
