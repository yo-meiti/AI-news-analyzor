# Configuration Template for render-bridge
# فایل تنظیمات برای render-bridge

# این متغیرها را در Render dashboard تنظیم کن
# Set these in Render environment variables

# ============ کاملاً ضروری ============

# سرویس تحلیل خبر
# مثال: https://llm-chat-app-template-v2.abc123def456.workers.dev
ANALYZER_API_BASE=

# سرویس تولید پرامپت تصویر
# مثال: https://prompt-generator-cf.abc123def456.workers.dev
PROMPT_API_BASE=

# سرویس تولید تصویر
# مثال: https://text-to-image-template.abc123def456.workers.dev
IMAGE_API_BASE=

# بات تلگرام endpoint برای اطلاع‌دهی
# مثال: https://telegram-news-bot.abc123def456.workers.dev/notify
TELEGRAM_NOTIFY_URL=

# توکن امنیتی برای POST /notify (باید با BOT_NOTIFY_TOKEN برابر باشد)
TELEGRAM_NOTIFY_TOKEN=

# آی‌دی پیش‌فرض چت تلگرام برای ارسال تصویر
TELEGRAM_DEFAULT_CHAT_ID=

# ============ اختیاری ============

# توکن امنیتی برای POST /run-rss/
RUN_SECRET=

# فیدهای RSS (جدا شده با کاما)
# اگر خالی باشد، فید پیش‌فرض Google News استفاده می‌شود
RSS_FEEDS=

# ============ Django ============

# کلید محرمانه Django (یک رشته تصادفی)
DJANGO_SECRET_KEY=

# حالت Debug (false برای production)
DJANGO_DEBUG=False

# اگر PostgreSQL استفاده کنی
# DATABASE_URL=postgresql://user:password@host:5432/database
